# Copy to .env and fill in. .env is gitignored and never leaves this machine.
TZ=America/Los_Angeles
PUID=1000
PGID=1000
# Published ports bind to this address. Use your Tailscale IP (`tailscale ip -4`)
# so services are reachable ONLY over your tailnet. "0.0.0.0" = all interfaces.
BIND_ADDR=100.x.y.z
# Absolute path where service data volumes live (gitignored).
DATA_ROOT=/home/<user>/Projects/homelab/data


# Syncthing（services/syncthing）：宿主机上放 Obsidian vault 的目录，容器内挂到 /vaults/<vault 名>
OBSIDIAN_ROOT=/home/<user>/Documents
# Syncthing Web GUI 登录（configure.sh 写入，Syncthing 存 bcrypt）。密码只用 A-Za-z0-9，例如 `openssl rand -hex 16`
SYNCTHING_GUI_USER=<user>
SYNCTHING_GUI_PASSWORD=<random>
# （可选）另一台设备：Syncthing 设备 ID 与它的 Tailscale IP；填好后重跑 configure.sh 即分享两个文件夹给它
MAC_DEVICE_ID=
MAC_TAILSCALE_IP=100.x.y.z

# Free LLM（services/free-llm）：jarvis 上的代码目录，和客户端调用 /v1 用的网关密钥（`openssl rand -hex 32`）
FREE_LLM_SRC=/home/<user>/Projects/free-llm
FREE_LLM_API_KEY=<random>

# 信息安全热点（services/security-hot）：jarvis 上的代码目录；站点自己的配置与密钥在 ${DATA_ROOT}/security-hot/app.env
SECURITY_HOT_SRC=/home/<user>/Projects/security-hot
